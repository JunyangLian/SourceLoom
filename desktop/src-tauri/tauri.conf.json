{
  "$schema": "../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "SourceLoom",
  "mainBinaryName": "SourceLoom",
  "version": "0.4.1",
  "identifier": "app.shiyuan.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "拾源 SourceLoom",
        "width": 1180,
        "height": 780,
        "minWidth": 960,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "resources": ["binaries/shiyuan-core/**/*"]
  }
}
